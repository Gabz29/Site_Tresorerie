.env
# Justificatifs envoyés par les utilisateurs : données personnelles et
# financières, volumineuses, qui n'ont rien à faire dans l'historique Git.
# Le dossier est HORS de public/ : Apache ne peut pas le servir, les
# fichiers ne sont accessibles que via ?page=justificatif, qui vérifie
# les droits. Le .gitkeep garde le dossier présent après un clone.
/uploads/*
!/uploads/.gitkeep

# Ancien emplacement, conservé au cas où des fichiers y traînent encore.
/public/uploads/*
!/public/uploads/.gitkeep
Notes_Perso.txt
Plan_Projet_Jumao.xlsx
Plan_Projet_Jumao_v1.xlsx
~$*
/.vscode/settings.json