# MODÈLE de configuration — ce fichier EST commité, contrairement à .env.
# Il donne les NOMS des variables à définir, jamais les vraies valeurs.
#
# Pour installer le projet sur une nouvelle machine :
#   1. copier ce fichier en .env
#   2. y renseigner les valeurs correspondant à la machine

# Adresse du serveur MySQL.
# Utiliser 127.0.0.1 plutôt que "localhost" sous Windows : localhost peut
# être résolu en IPv6 (::1) ou tenter une connexion par "named pipe", ce qui
# produit un échec de connexion au message incompréhensible.
DB_HOST=127.0.0.1

# Port du serveur MySQL.
# WAMP peut faire tourner plusieurs SGBD en parallèle (MySQL et MariaDB) sur
# des ports différents : on l'écrit explicitement pour savoir où l'on se connecte.
DB_PORT=3306

# Nom de la base de données.
DB_NAME=

# Identifiants de connexion (sous WAMP : root, sans mot de passe).
DB_USER=
DB_PASS=

# true  = affiche le détail des erreurs (développement en local)
# false = message générique, détails envoyés dans le journal (EN PRODUCTION)
APP_DEBUG=false
